{
  "manifest_version": 3,
  "name": "MYGPT Worker Orchestrator v5",
  "version": "0.5.0",
  "description": "Strategy-based isolated Custom GPT worker orchestration with proven fresh-chat fanout, generated-image recovery, and Run-time output permission preflight.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "MYGPT Worker Orchestrator v5",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "page_observer.js",
        "prompt_stacker_runner.js",
        "chatgpt_adapter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "route_adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
