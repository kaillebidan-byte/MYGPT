{
  "manifest_version": 3,
  "name": "MYGPT Worker Fanout v3",
  "version": "0.3.2",
  "description": "Three-slot MYGPT Custom GPT preparer using AutoGPT ChatGPT primitives in MAIN world plus Translation Loop runtime guard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MYGPT Worker Fanout v3",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "page_observer.js",
        "chatgpt_adapter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "route_adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
