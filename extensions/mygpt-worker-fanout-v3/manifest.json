{
  "manifest_version": 3,
  "name": "MYGPT Worker Fanout v4",
  "version": "0.4.0",
  "description": "Three isolated Custom GPT workers using Translation Loop control/submit evidence, AutoGPT upload/paste/passive observation, and VoiceBridge-style monitoring.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MYGPT Worker Fanout v4",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "page_observer.js",
        "prompt_stacker_runner.js",
        "chatgpt_adapter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "route_adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
