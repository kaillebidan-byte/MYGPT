{
  "version": 2,
  "name": "motion-keypose-2x2",
  "input": {
    "columns": 2,
    "rows": 2,
    "keypose_order": [
      "K1",
      "K2",
      "K3",
      "K4"
    ],
    "inbetween_order": [
      "I1",
      "I2",
      "I3",
      "I4"
    ],
    "alpha_threshold": 8,
    "edge_margin_px": 12
  },
  "output": {
    "cell_width": 256,
    "cell_height": 320,
    "padding_px": 16,
    "max_upscale": 1.25,
    "format": "PNG"
  }
}
